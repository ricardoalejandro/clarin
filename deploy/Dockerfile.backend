# syntax=docker/dockerfile:1
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN --mount=type=secret,id=proxy_ca,required=false \
    --mount=type=secret,id=system_ca,required=false \
    set -eu; \
    if [ -f /run/secrets/proxy_ca ]; then \
      ca_bundle=$(mktemp); \
      trap 'rm -f "$ca_bundle"' EXIT; \
      if [ -f /run/secrets/system_ca ]; then cat /run/secrets/system_ca > "$ca_bundle"; \
      else cat /etc/ssl/certs/ca-certificates.crt > "$ca_bundle"; fi; \
      cat /run/secrets/proxy_ca >> "$ca_bundle"; \
      export SSL_CERT_FILE="$ca_bundle"; \
    fi; \
    apk add --no-cache gcc musl-dev git sqlite-dev

# Copy go mod files
COPY go.mod go.sum ./
RUN --mount=type=cache,id=clarin-backend-gomod,target=/go/pkg/mod,sharing=locked \
    --mount=type=secret,id=proxy_ca,required=false \
    --mount=type=secret,id=system_ca,required=false \
    set -eu; \
    if [ -f /run/secrets/proxy_ca ]; then \
      ca_bundle=$(mktemp); \
      trap 'rm -f "$ca_bundle"' EXIT; \
      if [ -f /run/secrets/system_ca ]; then cat /run/secrets/system_ca > "$ca_bundle"; \
      else cat /etc/ssl/certs/ca-certificates.crt > "$ca_bundle"; fi; \
      cat /run/secrets/proxy_ca >> "$ca_bundle"; \
      export SSL_CERT_FILE="$ca_bundle"; \
    fi; \
    go mod download

# Copy source code
COPY . .

# Build with version info via ldflags
ARG BUILD_VERSION=dev
RUN --mount=type=cache,id=clarin-backend-gomod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=clarin-backend-build,target=/root/.cache/go-build,sharing=locked \
    --mount=type=secret,id=proxy_ca,required=false \
    --mount=type=secret,id=system_ca,required=false \
    set -eu; \
    if [ -f /run/secrets/proxy_ca ]; then \
      ca_bundle=$(mktemp); \
      trap 'rm -f "$ca_bundle"' EXIT; \
      if [ -f /run/secrets/system_ca ]; then cat /run/secrets/system_ca > "$ca_bundle"; \
      else cat /etc/ssl/certs/ca-certificates.crt > "$ca_bundle"; fi; \
      cat /run/secrets/proxy_ca >> "$ca_bundle"; \
      export SSL_CERT_FILE="$ca_bundle"; \
    fi; \
    CGO_ENABLED=1 GOOS=linux go build -mod=readonly -ldflags "-X main.Version=${BUILD_VERSION} -X main.BuildTime=$(date -u +%Y-%m-%dT%H:%M:%SZ)" -o /clarin ./cmd/server

# Runtime stage
FROM alpine:3.19

WORKDIR /app

# Install runtime dependencies
RUN --mount=type=secret,id=proxy_ca,required=false \
    --mount=type=secret,id=system_ca,required=false \
    set -eu; \
    if [ -f /run/secrets/proxy_ca ]; then \
      ca_bundle=$(mktemp); \
      trap 'rm -f "$ca_bundle"' EXIT; \
      if [ -f /run/secrets/system_ca ]; then cat /run/secrets/system_ca > "$ca_bundle"; \
      else cat /etc/ssl/certs/ca-certificates.crt > "$ca_bundle"; fi; \
      cat /run/secrets/proxy_ca >> "$ca_bundle"; \
      export SSL_CERT_FILE="$ca_bundle"; \
    fi; \
    apk add --no-cache ca-certificates tzdata sqlite-libs ffmpeg libreoffice-writer font-liberation

# Copy binary
COPY --from=builder /clarin /app/clarin

# Copy changelog for API serving
COPY --from=builder /app/CHANGELOG.md /app/CHANGELOG.md

# Create sessions directory
RUN mkdir -p /app/sessions

# Expose ports
EXPOSE 8080
EXPOSE 8081

# Run
CMD ["/app/clarin"]
