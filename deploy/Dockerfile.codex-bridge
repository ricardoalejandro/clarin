# syntax=docker/dockerfile:1
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV CODEX_HOME=/var/lib/codex

RUN --mount=type=cache,id=clarin-codex-bridge-npm,target=/root/.npm,sharing=locked \
    --mount=type=secret,id=proxy_ca,required=false \
    --mount=type=secret,id=system_ca,required=false \
    set -eu; \
    if [ -f /run/secrets/proxy_ca ]; then \
      ca_bundle=$(mktemp); \
      trap 'rm -f "$ca_bundle"' EXIT; \
      if [ -f /run/secrets/system_ca ]; then cat /run/secrets/system_ca > "$ca_bundle"; \
      else cat /etc/ssl/certs/ca-certificates.crt > "$ca_bundle"; fi; \
      cat /run/secrets/proxy_ca >> "$ca_bundle"; \
      export SSL_CERT_FILE="$ca_bundle"; \
      export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; \
    fi; \
    apk add --no-cache ca-certificates git; \
    npm install --strict-ssl=true -g @openai/codex@0.144.1

COPY package.json ./
COPY server.js ./

RUN mkdir -p /var/lib/codex /tmp/eros-codex-workspace

EXPOSE 8787

CMD ["node", "server.js"]
