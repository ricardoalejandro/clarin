FROM node:24.21.0-alpine@sha256:be80f76cf40ec8e42b9bec49f60a55e0660f30af58d3e5a25530785b30ea67e2 AS builder

WORKDIR /app

# Build arguments for API URLs
ARG NEXT_PUBLIC_API_URL=http://localhost:8080
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8080
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
ARG BUILD_VERSION=dev

# Set as environment variables for build
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_MARKETING_URL=$NEXT_PUBLIC_MARKETING_URL
ENV NEXT_PUBLIC_BUILD_VERSION=$BUILD_VERSION

# Copy package files
COPY package*.json ./
COPY vendor/excalidraw-clarin ./vendor/excalidraw-clarin
COPY vendor/sheetjs ./vendor/sheetjs

# Install dependencies (use npm ci if lock exists, otherwise npm install)
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Copy source code
COPY . .

# Build
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# Runtime stage
FROM node:24.21.0-alpine@sha256:be80f76cf40ec8e42b9bec49f60a55e0660f30af58d3e5a25530785b30ea67e2 AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0

# Copy necessary files
COPY --from=builder /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
# Keep the complete MIT notice with the distributed editor artifact. The
# prepare step also exposes a versioned copy beside the local editor assets.
COPY --from=builder /app/THIRD_PARTY_EXCALIDRAW.md ./THIRD_PARTY_EXCALIDRAW.md
COPY --from=builder /app/THIRD_PARTY_FABRIC.md ./THIRD_PARTY_FABRIC.md
COPY --from=builder /app/node_modules/xlsx/LICENSE ./THIRD_PARTY_SHEETJS_LICENSE.txt
# Vendored assets can originate in a private workspace (0600/0700). Keep
# public files root-owned but readable/traversable by the non-root server.
RUN chmod -R a+rX /app/public && \
    chmod a+r /app/THIRD_PARTY_EXCALIDRAW.md /app/THIRD_PARTY_FABRIC.md /app/THIRD_PARTY_SHEETJS_LICENSE.txt

EXPOSE 3000

USER node
CMD ["node", "server.js"]
