# syntax=docker/dockerfile:1
FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,id=clarin-offline-signer-gomod,target=/go/pkg/mod,sharing=locked \
    --mount=type=secret,id=proxy_ca,required=false \
    --mount=type=secret,id=system_ca,required=false \
    set -eu; \
    if [ -f /run/secrets/proxy_ca ]; then \
      ca_bundle=$(mktemp); \
      trap 'rm -f "$ca_bundle"' EXIT; \
      if [ -f /run/secrets/system_ca ]; then cat /run/secrets/system_ca > "$ca_bundle"; \
      else cat /etc/ssl/certs/ca-certificates.crt > "$ca_bundle"; fi; \
      cat /run/secrets/proxy_ca >> "$ca_bundle"; \
      export SSL_CERT_FILE="$ca_bundle"; \
    fi; \
    go mod download
COPY *.go ./
RUN --mount=type=cache,id=clarin-offline-signer-gomod,target=/go/pkg/mod,sharing=locked \
    --mount=type=cache,id=clarin-offline-signer-build,target=/root/.cache/go-build,sharing=locked \
    --mount=type=secret,id=proxy_ca,required=false \
    --mount=type=secret,id=system_ca,required=false \
    set -eu; \
    if [ -f /run/secrets/proxy_ca ]; then \
      ca_bundle=$(mktemp); \
      trap 'rm -f "$ca_bundle"' EXIT; \
      if [ -f /run/secrets/system_ca ]; then cat /run/secrets/system_ca > "$ca_bundle"; \
      else cat /etc/ssl/certs/ca-certificates.crt > "$ca_bundle"; fi; \
      cat /run/secrets/proxy_ca >> "$ca_bundle"; \
      export SSL_CERT_FILE="$ca_bundle"; \
    fi; \
    CGO_ENABLED=0 go build -mod=readonly -trimpath -ldflags="-s -w" -o /out/offline-signer .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/offline-signer /offline-signer
EXPOSE 8200
ENTRYPOINT ["/offline-signer"]
